<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stocks</title>
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <h1>Available Stocks</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Amount</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each products}}
                <li>{{this}}</li>
                <tr>
                    <td>{{name}}</td>
                    <td>{{amount}}</td>
                    <td>${{price}}</td>
                    <td>
                        <a class="btn" href="/buy/{{_id}}">Buy</a> | 
                        <a class="btn" href="/sell/{{_id}}">Sell</a>
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>
</body>

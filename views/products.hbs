<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stocks</title>
    <script>
        const productData = {{{productData}}};  // Injected from the controller

        const name = productData.map(product => product.name);  // Extract names for the chart
        const amount = productData.map(product => product.amount);  // Extract amounts
        const price = productData.map(product => product.price);  // Extract prices

    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <h1>Available Stocks</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Amount</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each products}}
                <tr>
                    <td>{{this.name}}</td>
                    <td>{{this.amount}}</td>
                    <td>${{this.price}}</td>
                    <td>
                        <form action="/regular/buy/{{this._id}}" method="post">
                            <label for="buyAmount">Amount to buy:</label>
                            <input type="number" id="buyAmount" name="buyAmount" placeholder="0" min="1" required>
                            <button type="submit">Buy</button>
                        </form>
                        <form action="/regular/sell/{{this._id}}" method="post">
                            <label for="sellAmount">Amount to sell:</label>
                            <input type="number" id="sellAmount" name="sellAmount" placeholder="0" min="1" required>
                            <button type="submit">Sell</button>
                        </form>
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>
</body>
</html>

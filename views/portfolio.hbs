<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio</title>
    <link rel="stylesheet" type="text/css" href="../public/style/styles.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <h1>My Portfolio</h1>
    <table>
        <thead>
            <tr>
                <th>Stock</th>
                <th>Amount Owned</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each portfolio}}
            <tr>
                <td>{{product.name}}</td>
                <td>{{product.amount}}</td>
                <td>
                    <a href="/sell/{{this._id}}">Sell</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</body>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio</title>
    <link rel="stylesheet" type="text/css" href="../public/style/styles.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <h1>My Portfolio</h1>
    <table>
        <thead>
            <tr>
                <th>Stock</th>
                <th>Owned</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each portfolio}}
            <tr>
                <td>{{product.name}}</td>
                <td>{{this.amount}}</td>
                <td>
                    <form action="/regular/sell/{{this._id}}" method="post">
                        <button type="submit">Sell</button>
                        <label for="sellAmount">Amount to sell:</label>
                        <input type="number" id="sellAmount" name="sellAmount" placeholder="0" min="1" required>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</body>

